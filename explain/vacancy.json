   ]
  },
  {
   "lines": [
    {
     "voice": "When a tenant *moves* out, the rent stops.",
     "do": [
      "out~moves"
     ]
    },
    {
     "voice": "On {two thousand|$2,000} a month, one empty month is {two thousand|$2,000} *gone*. That's about eight percent of the year.",
     "do": [
      "cnt~on",
      "gone~gone"
     ]
    },
    {
     "voice": "Then add cleaning, paint, and *repairs* before the next tenant moves in.",
     "do": [
